# Anime Manager Configuration
# Copy this file to .env and customize the values

# Directory where anime files are stored
# Windows example:
#ANIME_DIR=C:\Users\YourName\Anime
# Linux/macOS example:
ANIME_DIR=~/Anime

# AniList API Token (optional - for syncing progress)
# Leave empty to disable AniList features
ANILIST_TOKEN=

# AniList username for fetching your anime list
ANILIST_USERNAME=

# Flask configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Download settings
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_CHUNK_SIZE=1048576

# Cloudflare bypass mode: 'cloudscraper', 'selenium', or 'manual'
CLOUDFLARE_MODE=cloudscraper

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
